# Configuración de pc-screen-agent (este archivo: ~/.config/pc-screen-agent/agent.env)

# ---------------------------------------------------------------- esta PC
# El slug determina el entity_id en HA: binary_sensor.<slug>_pantalla
HOST_SLUG=escritorio
HOST_LABEL=Escritorio

# ------------------------------------------------ modo PUSH (REST API de HA)
# Publica el estado en Home Assistant. Es lo que hace que aparezca la entidad.
# Dejalo vacío si vas a usar la integración de HACS (el PC no necesita credenciales).
HA_URL=http://IP_O_HOSTNAME_HA:8123
HA_TOKEN=PEGA_AQUI_TU_TOKEN
# Opcional: si lo dejás vacío se calcula como binary_sensor.<HOST_SLUG>_pantalla
HA_ENTITY_ID=
# Cada cuántos segundos republica aunque no haya cambios (por si se reinició HA)
HA_HEARTBEAT=300

# ------------------------------------------- modo PULL (HTTP + SSE para la integración)
AGENT_BIND=0.0.0.0
AGENT_PORT=8099
# Vacío = sin autenticación. Poné un secreto si tu LAN no es de confianza.
AGENT_TOKEN=

# ---------------------------------------------------------------- detectores
# gnome  -> org.gnome.ScreenSaver (pantalla en blanco / bloqueada)
# logind -> login1 PrepareForSleep (suspensión / reanudación)
DETECTORS=gnome,logind

# Sondeo de seguridad: cada cuántos segundos el agente reconcilia el estado y
# reintenta conectar los detectores que hayan caído (por ejemplo si arrancó antes
# que el bus de sesión, o si se reinicia gnome-shell).
POLL_INTERVAL=30

# ------------------------------------------------------------ fuente del estado
# auto  = DPMS del kernel si hay conectores, si no el candado de GNOME (defecto)
# dpms  = sólo DPMS (recomendado en escritorios con monitor real)
# gnome = sólo el candado de GNOME: la pantalla recién se marca 'on' al DESBLOQUEAR
SCREEN_SOURCE=auto
# Cada cuántos segundos se lee el DPMS de /sys/class/drm (sólo cuando hay conectores)
DPMS_POLL=2
# Raíz del sysfs de DRM; se puede apuntar a un árbol falso para tests
DPMS_SYSFS_ROOT=/sys/class/drm

LOG_LEVEL=INFO