[Unit]
Description=pc-screen-agent — estado de la pantalla de esta PC para Home Assistant
# El detector de GNOME necesita el bus de sesión: arrancar después del graphical
# session evita el arranque en frío. Si aun así falla, el agente reintenta solo.
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/pc-screen-agent/agent.env
ExecStart=/usr/bin/python3 %h/.local/share/pc-screen-agent/pc-screen-agent.py
Restart=always
RestartSec=5
StandardOutput=append:%h/.local/share/pc-screen-agent/agent.log
StandardError=append:%h/.local/share/pc-screen-agent/agent.log

[Install]
WantedBy=default.target